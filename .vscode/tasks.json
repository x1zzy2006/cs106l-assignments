{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: prepare active-file build directory",
            "type": "process",
            "command": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "$null = New-Item -ItemType Directory -Force -Path '${fileDirname}/build'"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "C++: build active file (C++20)",
            "type": "cppbuild",
            "command": "D:/DevTools/winlibs-x86_64-posix-seh-gcc-16.1.0-mingw-w64ucrt-14.0.0-r1/mingw64/bin/g++.exe",
            "args": [
                "-std=c++20",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/build/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "C++: prepare active-file build directory",
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the active C++20 source file into its local build directory."
        }
    ]
}
